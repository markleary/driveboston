{
  "name": "driveboston",
  "version": "0.1.0",
  "private": true,
  "description": "Drive Boston: a browser driving game set in the real streets of Boston",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "node tools/check-forbidden.mjs",
    "geo": "node tools/geo.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "lil-gui": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/earcut": "3.2.4",
    "@types/node": "26.6.5",
    "@types/pngjs": "6.0.5",
    "@types/proj4": "2.19.0",
    "@types/three": "0.186.0",
    "earcut": "3.2.4",
    "fflate": "^0.8.3",
    "geotiff": "3.0.5",
    "pngjs": "7.0.0",
    "proj4": "2.22.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
